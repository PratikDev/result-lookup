# DB configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mydb

# Max Postgres connections for Redis fallback path
# Intentionally small — protects Postgres under Redis failure
PG_FALLBACK_MAX_CONN=20

# Redis configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redispassword

# App configuration
PORT=8080
BASE_URL=http://localhost:8080